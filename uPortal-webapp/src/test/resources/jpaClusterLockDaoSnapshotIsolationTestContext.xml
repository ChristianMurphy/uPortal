<!--
    JpaClusterLockDaoTest's context on a database whose transactions read from a snapshot, the
    way MySQL and MariaDB do by default (InnoDB's REPEATABLE READ): a transaction doesn't see
    rows that other transactions commit after its first read. An in-memory HSQLDB in MVCC mode
    with REPEATABLE READ sessions behaves the same, so this always runs on HSQLDB, whatever
    database the uportal.test.db.* properties select.
-->
<beans xmlns="http://www.springframework.org/schema/beans" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:util="http://www.springframework.org/schema/util"
    xsi:schemaLocation="http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans-3.1.xsd
                        http://www.springframework.org/schema/util http://www.springframework.org/schema/util/spring-util-3.1.xsd">

    <import resource="classpath:jpaClusterLockDaoTestContext.xml"/>

    <!-- Replaces the PortalDb data source of jpaClusterLockDaoTestContext.xml -->
    <bean id="PortalDb" parent="TestDb">
        <qualifier value="PortalDb" />
        <property name="driverClassName" value="org.hsqldb.jdbc.JDBCDriver" />
        <property name="url" value="jdbc:hsqldb:mem:uPortalSnapshotIsolationTest;hsqldb.tx=mvcc" />
        <property name="username" value="sa" />
        <property name="password" value="" />
        <property name="defaultTransactionIsolation">
            <util:constant static-field="java.sql.Connection.TRANSACTION_REPEATABLE_READ" />
        </property>
    </bean>
</beans>
