<beans xmlns="http://www.springframework.org/schema/beans" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans.xsd">

    <!--
     | jpaPortalTestApplicationContext.xml with the second-level and query caches on, as
     | properties/db/hibernate.cfg.xml sets them for the portal (minimal puts too). This factoryBean
     | replaces the one in sharedJpaTestContext.xml, which turns both caches off. The entities' own
     | @Cache annotations choose each region's concurrency strategy. Used with
     | org.apereo.portal.test.CacheRace.
     +-->
    <import resource="classpath:jpaPortalTestApplicationContext.xml"/>

    <bean id="factoryBean" class="org.apereo.portal.jpa.EventingLocalContainerEntityManagerFactoryBean" depends-on="" autowire="byType">
        <property name="jpaVendorAdapter" ref="jpaVendorAdapter" />
        <property name="persistenceUnitName" value="${persistenceUnitName}" />
        <property name="jpaProperties">
            <props>
                <prop key="hibernate.cache.use_second_level_cache">true</prop>
                <prop key="hibernate.cache.use_query_cache">true</prop>
                <prop key="hibernate.cache.use_minimal_puts">true</prop>
                <prop key="hibernate.cache.region.factory_class">org.hibernate.cache.ehcache.EhCacheRegionFactory</prop>
                <prop key="net.sf.ehcache.configurationResourceName">/cacheRaceTest-ehcache.xml</prop>
                <!-- Empty (the default in dataSource.properties): resolved from the JDBC metadata -->
                <prop key="hibernate.dialect">${hibernate.dialect}</prop>
                <prop key="persistenceUnitName">${persistenceUnitName}</prop>
            </props>
        </property>
    </bean>
</beans>
