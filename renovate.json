{
  "extends": [
    "config:recommended",
    ":preserveSemverRanges",
    ":dependencyDashboard",
    "helpers:pinGitHubActionDigests"
  ],
  "gradle": {
    "enabled": true
  },
  "major": {
    "dependencyDashboardApproval": true
  },
  "forkProcessing": "enabled",
  "customManagers": [
    {
      "customType": "regex",
      "description": "Database images in the workflow matrices and in the copy tool's integration tests, pinned as name:tag@digest (MOD-D25). The github-actions manager reads only literal service and container images, not matrix values.",
      "managerFilePatterns": [
        "/^\\.github/workflows/[^/]+\\.ya?ml$/",
        "/^uPortal-db-migrate/src/integrationTest/resources/db-images\\.properties$/"
      ],
      "matchStrings": [
        "image: (?<depName>[a-z0-9][a-z0-9./_-]*):(?<currentValue>[A-Za-z0-9][A-Za-z0-9._-]*)@(?<currentDigest>sha256:[a-f0-9]{64})"
      ],
      "datasourceTemplate": "docker"
    }
  ],
  "packageRules": [
    {
      "matchPackageNames": [
        "/^org.springframework:/",
        "/^org.springframework.data:/",
        "/^org.springframework.webflow:/"
      ],
      "allowedVersions": "< 5.0",
      "description": "Pinned to Spring Framework 4.3.x. Spring 5+ is a coordinated migration (API changes); Spring 6+ additionally needs Jakarta EE + Java 17."
    },
    {
      "matchPackageNames": [
        "/^org.springframework.security:/",
        "/^org.springframework.security.oauth:/"
      ],
      "allowedVersions": "< 5.0",
      "description": "Pinned to Spring Security 4.2.x. Bound to the Spring Framework 4.3.x line; bumps in lockstep with a Spring core migration."
    },
    {
      "matchPackageNames": [
        "/^org.hibernate:/",
        "/^org.hibernate.orm:/"
      ],
      "allowedVersions": "< 5.0",
      "description": "Pinned to Hibernate 4.2.x. Hibernate 5+ requires a coordinated migration (API + EntityManager changes); Hibernate 6+ (groupId rename to org.hibernate.orm) needs Jakarta EE and Java 17+."
    },
    {
      "groupName": "uPortal",
      "matchPackageNames": ["/^org.jasig.portal:/"]
    },
    {
      "groupName": "uPortal web components",
      "matchPackageNames": ["/^org.webjars.npm:uportal/"]
    },
    {
      "groupName": "Vite+ and Vitest",
      "matchFileNames": ["uPortal-webcomponents/package.json"],
      "matchPackageNames": ["vite-plus", "@vitest/browser", "@vitest/browser-playwright", "@vitest/coverage-v8", "playwright"],
      "description": "vite-plus bundles Vite and Vitest; the Vitest browser packages and Playwright must move with it (MOD-D20)."
    },
    {
      "groupName": "XState",
      "matchFileNames": ["uPortal-webcomponents/package.json"],
      "matchPackageNames": ["xstate", "@xstate/graph"],
      "description": "@xstate/graph has xstate as a peer dependency, so they move together (MOD-D31)."
    },
    {
      "matchFileNames": ["uPortal-webcomponents/package.json"],
      "matchPackageNames": ["bootstrap"],
      "dependencyDashboardApproval": true,
      "description": "Bootstrap 6 prereleases change markup and tokens; upgrade deliberately (MOD-D21)."
    },
    {
      "groupName": "Person Directory",
      "matchPackageNames": ["/^org.apereo.service.persondir/"]
    },
    {
      "groupName": "Lucene",
      "matchPackageNames": ["/^org.apache.lucene/"]
    },
    {
      "groupName": "Mockito",
      "matchPackageNames": ["/^org.mockito/"]
    },
    {
      "groupName": "JAXB2",
      "matchPackageNames": ["/^org.jvnet.jaxb2_commons/"]
    },
    {
      "groupName": "Resource Server",
      "matchPackageNames": ["/^org.jasig.resourceserver/"]
    },
    {
      "groupName": "Notification Portlet",
      "matchPackageNames": ["/^org.jasig.portlet.notification/"]
    },
    {
      "groupName": "AspectJ",
      "matchPackageNames": ["/^org.aspectj/"]
    },
    {
      "schedule": "on Monday",
      "matchPackageNames": ["/^com.amazonaws/"]
    },
    {
      "groupName": "SLF4J",
      "matchPackageNames": ["/^org.slf4j/"]
    },
    {
      "groupName": "Groovy",
      "matchPackageNames": ["/^org.codehaus.groovy/"]
    },
    {
      "groupName": "JSON Web Token",
      "matchPackageNames": ["/^io.jsonwebtoken/"]
    },
    {
      "groupName": "Apache Pluto",
      "matchPackageNames": ["/^org.apache.portals.pluto/"]
    },
    {
      "groupName": "JAXB",
      "matchPackageNames": ["/^com.sun.xml.bind/"]
    },
    {
      "groupName": "Jadira Usertype",
      "matchPackageNames": ["/^org.jadira.usertype/"]
    },
    {
      "groupName": "database images",
      "matchManagers": ["custom.regex"],
      "matchDatasources": ["docker"]
    },
    {
      "description": "A database server's release series (PostgreSQL 18, MySQL 9.7, MariaDB 12.3) is a decision about the supported matrix (MOD-D25) and needs a new baseline in uPortal-start; only digests and patch versions are updated automatically.",
      "matchManagers": ["custom.regex"],
      "matchDatasources": ["docker"],
      "matchUpdateTypes": ["major", "minor"],
      "enabled": false
    }
  ]
}
