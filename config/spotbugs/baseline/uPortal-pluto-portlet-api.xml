<!--
  SpotBugs baseline for uPortal-pluto-portlet-api: findings that predate the SpotBugs ratchet (MOD-D27).
  spotbugsMain ignores these and fails on anything else. Generated by
  `./gradlew :uPortal-pluto:uPortal-pluto-portlet-api:spotbugsBaseline`; don't add entries by hand.
  Shrink it by fixing findings and rerunning that task (or deleting their entries).
-->
<FindBugsFilter>
    <Match><Class name="javax.portlet.PortletMode"/><Method name="&lt;init&gt;"/><Bug pattern="CT_CONSTRUCTOR_THROW"/></Match>
    <Match><Class name="javax.portlet.WindowState"/><Method name="&lt;init&gt;"/><Bug pattern="CT_CONSTRUCTOR_THROW"/></Match>
    <Match><Class name="javax.portlet.filter.PortletRequestWrapper"/><Method name="&lt;init&gt;"/><Bug pattern="CT_CONSTRUCTOR_THROW"/></Match>
    <Match><Class name="javax.portlet.filter.PortletResponseWrapper"/><Method name="&lt;init&gt;"/><Bug pattern="CT_CONSTRUCTOR_THROW"/></Match>
</FindBugsFilter>
