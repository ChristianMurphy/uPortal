<?xml version="1.0" encoding="UTF-8"?>
<!--
  SpotBugs baseline for uPortal-soffit-connector: findings that predate the SpotBugs ratchet (MOD-D27).
  spotbugsMain ignores these and fails on anything else. Generated by
  `./gradlew :uPortal-soffit:uPortal-soffit-connector:spotbugsBaseline`; don't add entries by hand.
  Shrink it by fixing findings and rerunning that task (or deleting their entries).
-->
<FindBugsFilter>
    <Match><Class name="org.apereo.portal.soffit.DefinitionHeaderProvider"/><Method name="createHeader"/><Bug pattern="CRLF_INJECTION_LOGS"/></Match>
    <Match><Class name="org.apereo.portal.soffit.connector.PortalRequestHeaderProvider"/><Method name="createHeader"/><Bug pattern="DM_BOXED_PRIMITIVE_TOSTRING"/></Match>
    <Match><Class name="org.apereo.portal.soffit.connector.SoffitConnectorController"/><Method name="extractResponseAndCacheIfAppropriate"/><Bug pattern="RCN_REDUNDANT_NULLCHECK_OF_NONNULL_VALUE"/></Match>
    <Match><Class name="org.apereo.portal.soffit.connector.SoffitConnectorController"/><Method name="invokeService"/><Bug pattern="HTTP_PARAMETER_POLLUTION"/></Match>
    <Match><Class name="org.apereo.portal.soffit.connector.SoffitConnectorController"/><Method name="invokeService"/><Bug pattern="XSS_SERVLET"/></Match>
</FindBugsFilter>
