<?xml version="1.0" encoding="UTF-8"?>
<!--
  SpotBugs baseline for uPortal-index: findings that predate the SpotBugs ratchet (MOD-D27).
  spotbugsMain ignores these and fails on anything else. Generated by
  `./gradlew :uPortal-index:spotbugsBaseline`; don't add entries by hand.
  Shrink it by fixing findings and rerunning that task (or deleting their entries).
-->
<FindBugsFilter>
    <Match><Class name="org.apereo.portal.index.IndexConfiguration"/><Method name="directory"/><Bug pattern="PATH_TRAVERSAL_IN"/></Match>
</FindBugsFilter>
