<?xml version="1.0" encoding="UTF-8"?>
<!--
  SpotBugs baseline for uPortal-marketplace: findings that predate the SpotBugs ratchet (MOD-D27).
  spotbugsMain ignores these and fails on anything else. Generated by
  `./gradlew :uPortal-marketplace:spotbugsBaseline`; don't add entries by hand.
  Shrink it by fixing findings and rerunning that task (or deleting their entries).
-->
<FindBugsFilter>
    <Match><Class name="org.apereo.portal.rest.layout.MarketplaceEntry"/><Field name="layoutObject"/><Bug pattern="SE_BAD_FIELD"/></Match>
    <Match><Class name="org.apereo.portal.rest.layout.MarketplaceEntry"/><Field name="pdef"/><Bug pattern="SE_BAD_FIELD"/></Match>
    <Match><Class name="org.apereo.portal.rest.layout.MarketplaceEntry"/><Field name="personalizer"/><Bug pattern="SE_BAD_FIELD"/></Match>
    <Match><Class name="org.apereo.portal.rest.layout.MarketplaceEntry"/><Method name="getRating"/><Bug pattern="BX_UNBOXING_IMMEDIATELY_REBOXED"/></Match>
</FindBugsFilter>
