<?xml version="1.0" encoding="UTF-8"?>
<!--
  SpotBugs baseline for uPortal-security-filters: findings that predate the SpotBugs ratchet (MOD-D27).
  spotbugsMain ignores these and fails on anything else. Generated by
  `./gradlew :uPortal-security:uPortal-security-filters:spotbugsBaseline`; don't add entries by hand.
  Shrink it by fixing findings and rerunning that task (or deleting their entries).
-->
<FindBugsFilter>
    <Match><Class name="org.apereo.portal.security.filter.CorsFilter"/><Method name="&lt;init&gt;"/><Bug pattern="CT_CONSTRUCTOR_THROW"/></Match>
    <Match><Class name="org.apereo.portal.security.filter.CorsFilter"/><Method name="handleInvalidCORS"/><Bug pattern="CRLF_INJECTION_LOGS"/></Match>
    <Match><Class name="org.apereo.portal.security.filter.CorsFilter"/><Method name="handlePreflightCORS"/><Bug pattern="HRS_REQUEST_PARAMETER_TO_HTTP_HEADER"/></Match>
    <Match><Class name="org.apereo.portal.security.filter.CorsFilter"/><Method name="handlePreflightCORS"/><Bug pattern="HTTP_RESPONSE_SPLITTING"/></Match>
    <Match><Class name="org.apereo.portal.security.filter.CorsFilter"/><Method name="handlePreflightCORS"/><Bug pattern="PERMISSIVE_CORS"/></Match>
    <Match><Class name="org.apereo.portal.security.filter.CorsFilter"/><Method name="handleSimpleCORS"/><Bug pattern="CRLF_INJECTION_LOGS"/></Match>
    <Match><Class name="org.apereo.portal.security.filter.CorsFilter"/><Method name="handleSimpleCORS"/><Bug pattern="HTTP_RESPONSE_SPLITTING"/></Match>
    <Match><Class name="org.apereo.portal.security.filter.CorsFilter"/><Method name="handleSimpleCORS"/><Bug pattern="PERMISSIVE_CORS"/></Match>
    <Match><Class name="org.apereo.portal.security.filter.WebSecurityFilter"/><Method name="&lt;init&gt;"/><Bug pattern="CT_CONSTRUCTOR_THROW"/></Match>
</FindBugsFilter>
