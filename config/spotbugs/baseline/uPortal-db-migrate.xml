<?xml version="1.0" encoding="UTF-8"?>
<!--
  SpotBugs baseline for uPortal-db-migrate: findings that predate the SpotBugs ratchet (MOD-D27).
  spotbugsMain ignores these and fails on anything else. Generated by
  `./gradlew :uPortal-db-migrate:spotbugsBaseline`; don't add entries by hand.
  Shrink it by fixing findings and rerunning that task (or deleting their entries).
-->
<FindBugsFilter>
    <Match><Class name="org.apereo.portal.dbmigrate.DbMigrate"/><Method name="count"/><Bug pattern="SQL_INJECTION_SPRING_JDBC"/></Match>
    <Match><Class name="org.apereo.portal.dbmigrate.DbMigrate"/><Method name="run"/><Bug pattern="DLS_DEAD_LOCAL_STORE"/></Match>
    <Match><Class name="org.apereo.portal.dbmigrate.DbMigrateCli"/><Method name="parse"/><Bug pattern="PATH_TRAVERSAL_IN"/></Match>
    <Match><Class name="org.apereo.portal.dbmigrate.copy.GeneratorPositioner"/><Method name="maxId"/><Bug pattern="SQL_INJECTION_SPRING_JDBC"/></Match>
    <Match><Class name="org.apereo.portal.dbmigrate.copy.GeneratorPositioner"/><Method name="position"/><Bug pattern="SQL_INJECTION_SPRING_JDBC"/></Match>
    <Match><Class name="org.apereo.portal.dbmigrate.copy.GeneratorPositioner"/><Method name="~lambda\$resetIdentities\$\d+"/><Bug pattern="SQL_INJECTION_SPRING_JDBC"/></Match>
    <Match><Class name="org.apereo.portal.dbmigrate.copy.PostgresLargeObjects"/><Method name="count"/><Bug pattern="SQL_INJECTION_SPRING_JDBC"/></Match>
    <Match><Class name="org.apereo.portal.dbmigrate.copy.TableCopier"/><Method name="~lambda\$writer\$\d+"/><Bug pattern="SQL_INJECTION_SPRING_JDBC"/></Match>
    <Match><Class name="org.apereo.portal.dbmigrate.copy.TargetCleaner"/><Method name="~lambda\$clear\$\d+"/><Bug pattern="SQL_INJECTION_SPRING_JDBC"/></Match>
    <Match><Class name="org.apereo.portal.dbmigrate.report.MigrationReport"/><Method name="write"/><Bug pattern="NP_NULL_ON_SOME_PATH_FROM_RETURN_VALUE"/></Match>
    <Match><Class name="org.apereo.portal.dbmigrate.schema.Dialect"/><Method name="readSequence"/><Bug pattern="SQL_INJECTION_SPRING_JDBC"/></Match>
    <Match><Class name="org.apereo.portal.dbmigrate.schema.Dialect"/><Method name="readSequenceTable"/><Bug pattern="SQL_INJECTION_SPRING_JDBC"/></Match>
    <Match><Class name="org.apereo.portal.dbmigrate.verify.TableVerifier"/><Method name="~lambda\$hashSource\$\d+"/><Bug pattern="SQL_INJECTION_SPRING_JDBC"/></Match>
    <Match><Class name="org.apereo.portal.dbmigrate.verify.TableVerifier"/><Method name="~lambda\$hashTarget\$\d+"/><Bug pattern="SQL_INJECTION_SPRING_JDBC"/></Match>
</FindBugsFilter>
