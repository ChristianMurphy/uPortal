<?xml version="1.0" encoding="UTF-8"?>
<!--
  SpotBugs baseline for uPortal-health: findings that predate the SpotBugs ratchet (MOD-D27).
  spotbugsMain ignores these and fails on anything else. Generated by
  `./gradlew :uPortal-health:spotbugsBaseline`; don't add entries by hand.
  Shrink it by fixing findings and rerunning that task (or deleting their entries).
-->
<FindBugsFilter>
    <Match><Class name="org.apereo.portal.health.DatabaseHealthChecker"/><Method name="~lambda\$getDbResponseTime\$\d+"/><Bug pattern="ODR_OPEN_DATABASE_RESOURCE"/></Match>
    <Match><Class name="org.apereo.portal.health.DatabaseHealthChecker"/><Method name="~lambda\$getDbResponseTime\$\d+"/><Bug pattern="SQL_INJECTION_JDBC"/></Match>
</FindBugsFilter>
