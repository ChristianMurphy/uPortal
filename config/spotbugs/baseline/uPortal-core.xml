<?xml version="1.0" encoding="UTF-8"?>
<!--
  SpotBugs baseline for uPortal-core: findings that predate the SpotBugs ratchet (MOD-D27).
  spotbugsMain ignores these and fails on anything else. Generated by
  `./gradlew :uPortal-core:spotbugsBaseline`; don't add entries by hand.
  Shrink it by fixing findings and rerunning that task (or deleting their entries).
-->
<FindBugsFilter>
    <Match><Class name="org.apereo.portal.portlet.om.PortletParameterUtility"/><Method name="parameterMapToStringStringMap"/><Bug pattern="WMI_WRONG_MAP_ITERATOR"/></Match>
    <Match><Class name="org.apereo.portal.properties.PropertiesManager"/><Method name="getPropertyAsBoolean"/><Bug pattern="RCN_REDUNDANT_NULLCHECK_OF_NONNULL_VALUE"/></Match>
    <Match><Class name="org.apereo.portal.properties.PropertiesManager"/><Method name="setProperties"/><Bug pattern="USO_UNSAFE_STATIC_METHOD_SYNCHRONIZATION"/></Match>
    <Match><Class name="org.apereo.portal.security.PersonFactory"/><Method name="init"/><Bug pattern="ST_WRITE_TO_STATIC_FROM_INSTANCE_METHOD"/></Match>
    <Match><Class name="org.apereo.portal.utils.DocumentFactory"/><Method name="getDocumentFromStream"/><Bug pattern="XXE_DOCUMENT"/></Match>
    <Match><Class name="org.apereo.portal.utils.threading.DoubleCheckedCreator"/><Method name="&lt;init&gt;"/><Bug pattern="CT_CONSTRUCTOR_THROW"/></Match>
    <Match><Class name="~org\.apereo\.portal\.EntityTypes\$\d+"/><Method name="mapRow"/><Bug pattern="CRLF_INJECTION_LOGS"/></Match>
</FindBugsFilter>
