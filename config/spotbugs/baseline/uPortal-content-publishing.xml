<?xml version="1.0" encoding="UTF-8"?>
<!--
  SpotBugs baseline for uPortal-content-publishing: findings that predate the SpotBugs ratchet (MOD-D27).
  spotbugsMain ignores these and fails on anything else. Generated by
  `./gradlew :uPortal-content:uPortal-content-publishing:spotbugsBaseline`; don't add entries by hand.
  Shrink it by fixing findings and rerunning that task (or deleting their entries).
-->
<FindBugsFilter>
    <Match><Class name="org.apereo.portal.portlets.portletadmin.xmlsupport.XmlChannelPublishingDefinitionDao"/><Method name="&lt;init&gt;"/><Bug pattern="CT_CONSTRUCTOR_THROW"/></Match>
</FindBugsFilter>
