<?xml version="1.0" encoding="UTF-8"?>
<!--
  SpotBugs baseline for uPortal-tenants: findings that predate the SpotBugs ratchet (MOD-D27).
  spotbugsMain ignores these and fails on anything else. Generated by
  `./gradlew :uPortal-tenants:spotbugsBaseline`; don't add entries by hand.
  Shrink it by fixing findings and rerunning that task (or deleting their entries).
-->
<FindBugsFilter>
    <Match><Class name="org.apereo.portal.tenants.JpaTenant"/><Method name="compareTo"/><Bug pattern="EQ_COMPARETO_USE_OBJECT_EQUALS"/></Match>
    <Match><Class name="org.apereo.portal.tenants.JpaTenant_"/><Field name="attributes"/><Bug pattern="UUF_UNUSED_PUBLIC_OR_PROTECTED_FIELD"/></Match>
    <Match><Class name="org.apereo.portal.tenants.JpaTenant_"/><Field name="fname"/><Bug pattern="UWF_UNWRITTEN_PUBLIC_OR_PROTECTED_FIELD"/></Match>
    <Match><Class name="org.apereo.portal.tenants.JpaTenant_"/><Field name="id"/><Bug pattern="UUF_UNUSED_PUBLIC_OR_PROTECTED_FIELD"/></Match>
    <Match><Class name="org.apereo.portal.tenants.JpaTenant_"/><Field name="name"/><Bug pattern="UWF_UNWRITTEN_PUBLIC_OR_PROTECTED_FIELD"/></Match>
    <Match><Class name="org.apereo.portal.tenants.TemplateDataTenantOperationsListener"/><Method name="createImportReportLineItem"/><Bug pattern="POTENTIAL_XML_INJECTION"/></Match>
    <Match><Class name="org.apereo.portal.tenants.TemplateDataTenantOperationsListener"/><Method name="onDelete"/><Bug pattern="POTENTIAL_XML_INJECTION"/></Match>
    <Match><Class name="org.apereo.portal.tenants.TenantService"/><Method name="deleteTenantByFName"/><Bug pattern="RCN_REDUNDANT_NULLCHECK_WOULD_HAVE_BEEN_A_NPE"/></Match>
</FindBugsFilter>
