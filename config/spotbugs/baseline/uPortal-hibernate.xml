<?xml version="1.0" encoding="UTF-8"?>
<!--
  SpotBugs baseline for uPortal-hibernate: findings that predate the SpotBugs ratchet (MOD-D27).
  spotbugsMain ignores these and fails on anything else. Generated by
  `./gradlew :uPortal-hibernate:spotbugsBaseline`; don't add entries by hand.
  Shrink it by fixing findings and rerunning that task (or deleting their entries).
-->
<FindBugsFilter>
    <Match><Class name="org.hibernate.cache.ehcache.SpringBeanEhCacheRegionFactory"/><Field name="logger"/><Bug pattern="SE_BAD_FIELD"/></Match>
    <Match><Class name="org.hibernate.tool.hbm2ddl.FixedDatabaseMetadata"/><Method name="&lt;init&gt;"/><Bug pattern="CT_CONSTRUCTOR_THROW"/></Match>
    <Match><Class name="org.hibernate.tool.hbm2ddl.FixedDatabaseMetadata"/><Method name="initSequences"/><Bug pattern="SQL_INJECTION_JDBC"/></Match>
</FindBugsFilter>
