<!--
  SpotBugs baseline for uPortal-pluto-taglib: findings that predate the SpotBugs ratchet (MOD-D27).
  spotbugsMain ignores these and fails on anything else. Generated by
  `./gradlew :uPortal-pluto:uPortal-pluto-taglib:spotbugsBaseline`; don't add entries by hand.
  Shrink it by fixing findings and rerunning that task (or deleting their entries).
-->
<FindBugsFilter>
    <Match><Class name="org.apache.pluto.tags.BaseURLTag"/><Method name="doEndTag"/><Bug pattern="URL_REWRITING"/></Match>
    <Match><Class name="org.apache.pluto.tags.BaseURLTag"/><Method name="setSecure"/><Bug pattern="DM_BOOLEAN_CTOR"/></Match>
    <Match><Class name="org.apache.pluto.tags.BaseURLTag"/><Method name="setUrlParameters"/><Bug pattern="WMI_WRONG_MAP_ITERATOR"/></Match>
    <Match><Class name="org.apache.pluto.tags.BaseURLTag"/><Method name="setUrlProperties"/><Bug pattern="WMI_WRONG_MAP_ITERATOR"/></Match>
    <Match><Class name="org.apache.pluto.tags.PortletURLTag286"/><Method name="doCopyCurrentRenderParameters"/><Bug pattern="WMI_WRONG_MAP_ITERATOR"/></Match>
    <Match><Class name="org.apache.pluto.tags.ResourceURLTag286"/><Field name="resourceURL"/><Bug pattern="SE_BAD_FIELD"/></Match>
    <Match><Class name="org.apache.pluto.tags.el.ExpressionEvaluatorProxy"/><Method name="isPageContextMethodAvailable"/><Bug pattern="RCN_REDUNDANT_NULLCHECK_OF_NONNULL_VALUE"/></Match>
    <Match><Class name="org.apache.pluto.tags.el.ParamTag"/><Bug pattern="NM_SAME_SIMPLE_NAME_AS_SUPERCLASS"/></Match>
    <Match><Class name="org.apache.pluto.tags.el.PropertyTag"/><Bug pattern="NM_SAME_SIMPLE_NAME_AS_SUPERCLASS"/></Match>
</FindBugsFilter>
